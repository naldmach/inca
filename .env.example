# Copy to .env.local and fill in. Never commit .env.local.
#
# PUBLIC — these are inlined into the browser bundle at build time.
# Treat every value here as readable by anyone who visits the site.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Public by design. It is only safe because
# row-level security restricts what it can reach — see
# database/fix-rls-policies.sql. If RLS is off, this key exposes the database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY — secret. Never prefix these with NEXT_PUBLIC_, never log them,
# never reference them from a client component.

# Supabase service role key. Bypasses row-level security entirely. Used by
# src/lib/supabase/admin.ts for user lookups, writes and image uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signing key for the session cookie. At least 32 random characters.
# Generate with: openssl rand -base64 32
# The app refuses to issue or verify tokens without it — there is no fallback.
JWT_SECRET=generate-me-do-not-reuse-across-environments
